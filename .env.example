# ============================================================================
# JOB.ai configuration. Copy to `.env` and edit. Never commit `.env`.
# Every value below has a working default; nothing here is required to
# start except TELEGRAM_TOKEN (only if you run the bot).
# ============================================================================

# --- LLM: local Ollama only. There are no external LLM API keys. -----------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=180
OLLAMA_MAX_RETRIES=2

# --- Retrieval models ------------------------------------------------------
# EMBEDDING_MODEL must stay bge-large-en-v1.5 to keep the committed FAISS index
# usable: it is 1024-dimensional and the stored vectors were built with it.
# Changing this requires a full re-index (`python -m jobai migrate`).
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=1

# --- Index locations (relative paths resolve against the repo root) --------
VECTOR_DB_PATH=vector_store
BM25_INDEX_PATH=vector_store/bm25.pkl
PROFILE_CACHE_PATH=.cache/profiles
GRAPH_FALLBACK_PATH=.cache/graph.json

# --- Retrieval funnel sizes ------------------------------------------------
DENSE_K=150            # FAISS candidates
LEXICAL_K=150          # BM25 candidates
GRAPH_K=150            # graph candidates
FUSION_K=80            # survivors of RRF that reach the reranker (the "top 50-100")
RERANK_K=20            # survivors of the reranker that reach Qwen (the "top 10-20")
RRF_K=60               # RRF smoothing constant
QUERY_EXPANSION_ENABLED=1
FRESHNESS_HALF_LIFE_DAYS=21

# --- Scoring weights (relative; they are normalized by their sum) ----------
WEIGHT_RERANKER_SCORE=0.30
WEIGHT_SEMANTIC_MATCH=0.15
WEIGHT_REQUIRED_SKILL_MATCH=0.18
WEIGHT_PREFERRED_SKILL_MATCH=0.05
WEIGHT_SKILL_MATCH=0.10
WEIGHT_EXPERIENCE_MATCH=0.08
WEIGHT_LOCATION_MATCH=0.05
WEIGHT_ROLE_MATCH=0.05
WEIGHT_GRAPH_SIMILARITY=0.02
WEIGHT_FRESHNESS=0.02

# --- MongoDB (existing databases and collections; do not rename casually) --
MONGO_DB_URI=mongodb://localhost:27017
MONGO_USER_DB=USER
MONGO_USER_COLLECTION=JOB_USER
MONGO_JOB_DB=USER_1
MONGO_JOB_COLLECTION=JOB_Data
MONGO_RECOMMENDATION_COLLECTION=Job_specific

# --- Graph database (optional) ---------------------------------------------
# When Neo4j is unreachable, graph retrieval transparently falls back to an
# equivalent in-process graph. Retrieval never fails because of this.
GRAPH_ENABLED=1
GRAPH_DB_URI=bolt://localhost:7687
GRAPH_DB_USER=neo4j
GRAPH_DB_PASSWORD=
GRAPH_DB_DATABASE=neo4j

# --- Telegram --------------------------------------------------------------
TELEGRAM_TOKEN=
# TOKEN= is still read as a fallback for the pre-upgrade variable name.

# --- Scraping --------------------------------------------------------------
SCRAPER_HEADLESS=1
SCRAPER_REQUEST_DELAY=2.5       # seconds between requests; keep this polite
SCRAPER_PAGE_TIMEOUT=25
SCRAPER_MAX_RETRIES=2
SCRAPER_MAX_PAGES=5
SCRAPER_MAX_JOBS_PER_SOURCE=200
# SCRAPER_USER_AGENT=
# CHROMEDRIVER_PATH=            # leave empty to let Selenium Manager fetch it
# SCRAPER_PROXY_FILE=           # optional ip:port:user:pass per line, outside the repo

LINKEDIN_KEYWORDS=Software Engineer|Data Scientist|Machine Learning Engineer
LINKEDIN_LOCATIONS=India
NAUKRI_KEYWORDS=software engineer|data scientist|machine learning engineer
NAUKRI_LOCATIONS=india
NAUKRI_FETCH_DETAILS=1          # open each result for the full description

# --- Storage paths ---------------------------------------------------------
RESUME_DIR=data/resumes
RAW_DATA_DIR=data/raw
LOG_LEVEL=INFO
